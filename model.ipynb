   "source": [
    "### Inverst Function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 262,
   "id": "-Ce4a1bJjTm2",
   "metadata": {
    "id": "-Ce4a1bJjTm2"
   },
   "outputs": [],
   "source": [
    "def inverst(x,scaler,target_index):\n",
    "    return x * scaler.scale_[target_index] + scaler.mean_[target_index]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 263,
   "id": "15c75c99",
   "metadata": {
    "id": "15c75c99"
   },
   "outputs": [],
   "source": [
    "class TimeSeriesDataset(Dataset):\n",
    "    def __init__(self, data, seq_len, pred_len, target_index):\n",
    "        self.data = data\n",
    "        self.seq_len = seq_len\n",
    "        self.pred_len = pred_len\n",
    "        self.target_index = target_index\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.data) - self.seq_len - self.pred_len + 1\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        x = self.data[idx:idx+self.seq_len]\n",
    "        y = self.data[idx+self.seq_len:idx+self.seq_len+self.pred_len, self.target_index]\n",
    "        return torch.tensor(x, dtype=torch.float32), torch.tensor(y, dtype=torch.float32)"
   ]
  },
