   "source": [
    "stl = STL(df[\"OT\"], period=24)\n",
    "res = stl.fit()\n",
    "\n",
    "trend = res.trend\n",
    "seasonal = res.seasonal\n",
    "residual = res.resid\n",
    "\n",
    "df[\"trend\"] = trend\n",
    "df[\"seasonal\"] = seasonal\n",
    "df[\"residual\"] = residual\n",
    "\n"
   ]
