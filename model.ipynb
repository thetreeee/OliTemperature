    ").to(device)\n",
    "atm_criterion = nn.MSELoss()\n",
    "atm_optimizer = torch.optim.AdamW(attention_model.parameters(), lr=lr)\n",
    "atm_scheduler_reduce = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "    atm_optimizer,\n",
    "    mode = 'min',\n",
