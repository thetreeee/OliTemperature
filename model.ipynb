":["scaler = StandardScaler()\n","\n","train_scaled = scaler.fit_transform(train_df.values)\n","val_scaled   = scaler.transform(val_df.values)\n","test_scaled  = scaler.transform(test_df.values)"]},{"cell_type":"markdown","id":"MfyxxHTojTm2","metadata":{"id":"MfyxxHTojTm2"},"source":["### Inverst Function"]},{"cell_type":"code","execution_count":691,"id":"-Ce4a1bJjTm2","metadata":{"id":"-Ce4a1bJjTm2","executionInfo":{"status":"ok","timestamp":1774708790179,"user_tz":-420,"elapsed":19,"user":{"displayName":"Khánh An","userId":"13600834306217372631"}}},"outputs":[],"source":["def inverst(x,scaler,target_index):\n","    return x * scaler.scale_[target_index] + scaler.mean_[target_index]"]},{"cell_type":"code","execution_count":692,"id":"15c75c99","metadata":{"id":"15c75c99","executionInfo":{"status":"ok","timestamp":1774708790179,"user_tz":-420,"elapsed":16,"user":{"displayName":"Khánh An","userId":"13600834306217372631"}}},"outputs":[],"source":["class TimeSeriesDataset(Dataset):\n","    def __init__(self, data, seq_len, pred_len, target_index):\n","        self.data = data\n","        self.seq_len = seq_len\n","        self.pred_len = pred_len\n","        self.target_index = target_index\n","\n","    def __len__(self):\n","        return len(self.data) - self.seq_len - self.pred_len + 1\n","\n","    def __getitem__(self, idx):\n","        x = self.data[idx:idx+self.seq_len]\n","        y = self.data[idx+self.seq_len:idx+self.seq_len+self.pred_len, self.target_index]\n","        return torch.tensor(x, dtype=torch.float32), torch.tensor(y, dtype=torch.float32)"]},{"cell_type":"code","execution_count":693,"id":"0e727d23","metadata":{"id":"0e727d23","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1774708790180,"user_tz":-420,"elapsed":15,"user":{"displayName":"Khánh An","userId":"13600834306217372631"}},"outputId":"864cb734-a1dd-410d-ca94-272fc06dc553"},"outputs":[{"output_type":"stream","name":"stdout","text":["4\n"]}],"source":